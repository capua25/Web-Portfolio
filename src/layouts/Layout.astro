---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import AlteHaasGroteskBoldUrl from "../fonts/AlteHaasGroteskBold.ttf";
import SimplyMonoBookUrl from "../fonts/SimplyMono-Book.ttf";

const currentLang = Astro.currentLocale || "en";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const pageDescription =
    description ??
    "Martín Capuano's personal portfolio as software and web developer.";

// Canonical: URL absoluta de la página actual, derivada de Astro.url/Astro.site,
// sin query string y con la barra final normalizada (la raíz conserva "/", el resto no la lleva).
const canonicalPath =
    Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/+$/, "");
const canonicalURL = new URL(canonicalPath, Astro.site);

// hreflang / alternates: una entrada por idioma soportado + x-default apuntando al defaultLocale ("en").
// getAbsoluteLocaleUrl("es", "/") devuelve la URL con barra final ("/es/"); se normaliza con la
// misma regla que el canonical para que el hreflang de una página coincida con su propio canonical.
function withoutTrailingSlash(url: string) {
    const parsed = new URL(url);
    if (parsed.pathname !== "/" && parsed.pathname.endsWith("/")) {
        parsed.pathname = parsed.pathname.replace(/\/+$/, "");
    }
    return parsed.toString();
}

const alternateEn = withoutTrailingSlash(getAbsoluteLocaleUrl("en", "/"));
const alternateEs = withoutTrailingSlash(getAbsoluteLocaleUrl("es", "/"));

// og:image / twitter:image requieren URL absoluta para que los crawlers sociales la resuelvan.
const ogImagePath = ogImage ?? "/og-image.png";
const absoluteOgImage = new URL(ogImagePath, Astro.site).toString();

const ogImageAlt =
    currentLang === "es"
        ? "Martín Capuano - Desarrollador de Software"
        : "Martín Capuano - Software Developer";

const ogLocale = currentLang === "es" ? "es_ES" : "en_US";
const ogLocaleAlternate = currentLang === "es" ? "en_US" : "es_ES";

// JSON-LD Person: solo campos verificables en el repo (Footer.astro / Contacto.astro para sameAs,
// i18n/ui.ts para jobTitle). Nada inventado (sin email, teléfono, dirección, etc.).
const personJsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Martín Capuano",
    url: Astro.site?.toString(),
    jobTitle: "Software Developer",
    sameAs: [
        "https://www.linkedin.com/in/capuanomartin/",
        "https://github.com/capua25/",
    ],
};
---

<!doctype html>
<html lang={currentLang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/webp" href="/M5.webp" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link
            rel="preload"
            as="font"
            type="font/ttf"
            href={AlteHaasGroteskBoldUrl}
            crossorigin
        />
        <link
            rel="preload"
            as="font"
            type="font/ttf"
            href={SimplyMonoBookUrl}
            crossorigin
        />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="en" href={alternateEn} />
        <link rel="alternate" hreflang="es" href={alternateEs} />
        <link rel="alternate" hreflang="x-default" href={alternateEn} />
        <meta name="author" content="Martín Capuano" />
        <meta
            name="keywords"
            content="Martín Capuano, Martín, Capuano, Portfolio, Developer, Web Developer, Full Stack Developer, JavaScript, TypeScript, Node.js, Astro, Windev, Uruguay"
        />
        <meta name="description" content={pageDescription} />
        <meta
            name="robots"
            content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
        <meta
            property="og:title"
            content="Martín Capuano - Software Developer"
        />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={absoluteOgImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:locale:alternate" content={ogLocaleAlternate} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:title"
            content="Martín Capuano - Software Developer"
        />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={absoluteOgImage} />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(personJsonLd)}
            is:inline
        />
        <script is:inline>
            const theme =
                localStorage.getItem("theme") ??
                (window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light");
            document.documentElement.classList.toggle("dark", theme === "dark");
        </script>
    </head>
    <body
        class="bg-background-light dark:bg-background-dark font-display text-gray-800 dark:text-gray-200"
    >
        <slot />
    </body>
</html>

<style is:global>
    @font-face {
        font-family: "AlteHaasGroteskBold";
        src: url("../fonts/AlteHaasGroteskBold.ttf");
        font-weight: 700;
        font-display: swap;
    }
    @font-face {
        font-family: "AlteHaasGroteskRegular";
        src: url("../fonts/AlteHaasGroteskRegular.ttf");
        font-weight: 400;
        font-display: swap;
    }
    @font-face {
        font-family: "JA";
        src: url("../fonts/SimplyMono-Book.ttf");
        font-display: swap;
    }
    html {
        font-family: "JA", system-ui, sans-serif;
        scroll-behavior: smooth;
    }
    h1,
    h2,
    h3 {
        font-family: "AlteHaasGroteskBold", system-ui, sans-serif;
    }
    body::-webkit-scrollbar {
        display: none;
    }
    code {
        font-family:
            Menlo,
            Monaco,
            Lucida Console,
            Liberation Mono,
            DejaVu Sans Mono,
            Bitstream Vera Sans Mono,
            Courier New,
            monospace;
    }
    .group:hover .group-hover\:block {
        display: block;
    }
</style>
