---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import AlteHaasGroteskBoldUrl from "../fonts/AlteHaasGroteskBold.ttf";
import SimplyMonoBookUrl from "../fonts/SimplyMono-Book.ttf";
import { personJsonLd } from "../lib/seo";

const currentLang = Astro.currentLocale || "en";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    /**
     * Rutas (no URLs absolutas) para el hreflang de esta página en cada
     * idioma, ej. { en: "/case-studies/pinar", es: "/es/casos/pinar" }.
     * Si se omite, el hreflang apunta a la home de cada idioma (comportamiento
     * actual, sin cambios) — necesario porque getAbsoluteLocaleUrl(lang, "/")
     * siempre resuelve a la home y no tiene forma de apuntar a otra ruta.
     */
    alternates?: { en: string; es: string };
    /**
     * JSON-LD adicional para la página (ej. Article/CreativeWork de un caso
     * de estudio). Se inyecta en un script propio (application/ld+json), sin
     * reemplazar el JSON-LD de Person que ya lleva toda página.
     */
    jsonLd?: Record<string, unknown>;
}

const { title, description, ogImage, alternates, jsonLd } = Astro.props;

const pageDescription =
    description ??
    "Martín Capuano's personal portfolio as software and web developer.";

// Canonical: URL absoluta de la página actual, derivada de Astro.url/Astro.site,
// sin query string y con la barra final normalizada (la raíz conserva "/", el resto no la lleva).
const canonicalPath =
    Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/+$/, "");
const canonicalURL = new URL(canonicalPath, Astro.site);

// hreflang / alternates: una entrada por idioma soportado + x-default apuntando al defaultLocale ("en").
// getAbsoluteLocaleUrl("es", "/") devuelve la URL con barra final ("/es/"); se normaliza con la
// misma regla que el canonical para que el hreflang de una página coincida con su propio canonical.
function withoutTrailingSlash(url: string) {
    const parsed = new URL(url);
    if (parsed.pathname !== "/" && parsed.pathname.endsWith("/")) {
        parsed.pathname = parsed.pathname.replace(/\/+$/, "");
    }
    return parsed.toString();
}

// Cuando se pasa `alternates`, sus rutas ya son absolutas-relativas al sitio
// (incluyen el prefijo de idioma, ej. "/es/casos/pinar") así que se resuelven
// directo contra Astro.site en vez de pasar por getAbsoluteLocaleUrl.
const alternateEn = alternates
    ? withoutTrailingSlash(new URL(alternates.en, Astro.site).toString())
    : withoutTrailingSlash(getAbsoluteLocaleUrl("en", "/"));
const alternateEs = alternates
    ? withoutTrailingSlash(new URL(alternates.es, Astro.site).toString())
    : withoutTrailingSlash(getAbsoluteLocaleUrl("es", "/"));

// og:image / twitter:image requieren URL absoluta para que los crawlers sociales la resuelvan.
const ogImagePath = ogImage ?? "/og-image.png";
const absoluteOgImage = new URL(ogImagePath, Astro.site).toString();

const ogImageAlt =
    currentLang === "es"
        ? "Martín Capuano - Desarrollador de Software"
        : "Martín Capuano - Software Developer";

const ogLocale = currentLang === "es" ? "es_ES" : "en_US";
const ogLocaleAlternate = currentLang === "es" ? "en_US" : "es_ES";

// Escapa "<" para que un `jsonLd` con texto libre (ej. el resumen de un caso
// de estudio) no pueda cerrar el bloque de script antes de tiempo con un
// cierre de etiqueta prematuro. El JSON-LD de Person no lo necesita (son
// strings fijos del código), pero `jsonLd` viene de contenido (frontmatter
// de un .mdx), así que se lo trata como no confiable.
function safeJsonLdHtml(data: Record<string, unknown>) {
    return JSON.stringify(data).replace(/</g, "\\u003c");
}

// JSON-LD Person: ver src/lib/seo.ts. Se importa (en vez de definirse acá) para
// que los casos de estudio puedan referenciar exactamente el mismo autor en su
// propio JSON-LD sin duplicar los datos — un .astro no puede exportar valores
// (regla astro/no-exports-from-components), así que el dato vive en un módulo.
---

<!doctype html>
<html lang={currentLang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/webp" href="/M5.webp" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link
            rel="preload"
            as="font"
            type="font/ttf"
            href={AlteHaasGroteskBoldUrl}
            crossorigin
        />
        <link
            rel="preload"
            as="font"
            type="font/ttf"
            href={SimplyMonoBookUrl}
            crossorigin
        />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="en" href={alternateEn} />
        <link rel="alternate" hreflang="es" href={alternateEs} />
        <link rel="alternate" hreflang="x-default" href={alternateEn} />
        <meta name="author" content="Martín Capuano" />
        <meta
            name="keywords"
            content="Martín Capuano, Martín, Capuano, Portfolio, Developer, Web Developer, Full Stack Developer, JavaScript, TypeScript, Node.js, Astro, Windev, Uruguay"
        />
        <meta name="description" content={pageDescription} />
        <meta
            name="robots"
            content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
        <meta
            property="og:title"
            content="Martín Capuano - Software Developer"
        />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={absoluteOgImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:locale:alternate" content={ogLocaleAlternate} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:title"
            content="Martín Capuano - Software Developer"
        />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={absoluteOgImage} />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(personJsonLd)}
            is:inline
        />
        {
            jsonLd && (
                <script
                    type="application/ld+json"
                    set:html={safeJsonLdHtml(jsonLd)}
                    is:inline
                />
            )
        }
        <script is:inline>
            const theme =
                localStorage.getItem("theme") ??
                (window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light");
            document.documentElement.classList.toggle("dark", theme === "dark");
        </script>
    </head>
    <body
        class="bg-background-light dark:bg-background-dark font-display text-gray-800 dark:text-gray-200"
    >
        <slot />
    </body>
</html>

<style is:global>
    @font-face {
        font-family: "AlteHaasGroteskBold";
        src: url("../fonts/AlteHaasGroteskBold.ttf");
        font-weight: 700;
        font-display: swap;
    }
    @font-face {
        font-family: "AlteHaasGroteskRegular";
        src: url("../fonts/AlteHaasGroteskRegular.ttf");
        font-weight: 400;
        font-display: swap;
    }
    @font-face {
        font-family: "JA";
        src: url("../fonts/SimplyMono-Book.ttf");
        font-display: swap;
    }
    html {
        font-family: "JA", system-ui, sans-serif;
        scroll-behavior: smooth;
    }
    h1,
    h2,
    h3 {
        font-family: "AlteHaasGroteskBold", system-ui, sans-serif;
    }
    body::-webkit-scrollbar {
        display: none;
    }
    code {
        font-family:
            Menlo,
            Monaco,
            Lucida Console,
            Liberation Mono,
            DejaVu Sans Mono,
            Bitstream Vera Sans Mono,
            Courier New,
            monospace;
    }
    .group:hover .group-hover\:block {
        display: block;
    }
</style>
