---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { useTranslation } from "../i18n/utils";
import { existeCasoEnIdioma } from "../lib/i18n-routes";
import { labels } from "../i18n/ui";
import PinAr from "../img/proyectos/pinarsports.webp";
import CajaNeta from "../img/proyectos/cajanetaapp.webp";
import Eurogen from "../img/proyectos/eurogen.webp";
import Rustico from "../img/proyectos/rustico.webp";
import Sonora from "../img/proyectos/sonora.webp";
import Modal from "../components/Modal.astro";

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);

type ProyectoId = "p1" | "p2" | "p3" | "p5" | "p6";

type ProyectoLink = {
    labelKey: "pj.button1" | "pj.button2" | "pj.button3";
    href: string;
    variant: "primary" | "secondary";
};

// El botón al caso de estudio de PinAr solo se muestra si existe una entrada
// de la colección `casos` publicada para el idioma actual: hoy solo existe
// pinar.es.mdx (y con publicado: false), así que en inglés, o en producción
// antes de publicar, este botón no aparece — evita mandar al visitante a un
// /case-studies/pinar que todavía no genera página (404). Misma guarda
// (incluido el criterio de `publicado`) que usan las rutas
// src/pages/{es/casos,case-studies}/[slug].astro, centralizada en
// src/lib/i18n-routes.ts.
const casoPinarDisponible = await existeCasoEnIdioma(
    "pinar",
    currentLang as "es" | "en",
);
const casoPinarHref =
    currentLang === "es" ? "/es/casos/pinar" : "/case-studies/pinar";

const pinArLinks: ProyectoLink[] = casoPinarDisponible
    ? [
          {
              labelKey: "pj.button3",
              href: casoPinarHref,
              variant: "primary",
          },
          {
              labelKey: "pj.button1",
              href: "https://pinarsports.com",
              variant: "secondary",
          },
      ]
    : [
          {
              labelKey: "pj.button1",
              href: "https://pinarsports.com",
              variant: "secondary",
          },
      ];

type Proyecto = {
    /** Sufijo de las claves i18n: pj.{id}name / pj.{id}text */
    id: ProyectoId;
    image: ImageMetadata;
    alt: string;
    /** Alt de la imagen ampliada en el Modal, si difiere del alt del thumbnail. Si se omite, usa `alt`. */
    modalAlt?: string;
    /** Variante A/C: uno o más <a>. */
    links?: ProyectoLink[];
    /** Variante B: abre un Modal con la imagen ampliada. Debe ser único en toda la página (ids globales). */
    modalN?: number;
    /** Destaca la card ocupando 2 columnas en el grid de 3 (xl+), para cerrar el grid sin huecos. */
    featured?: boolean;
};

const PRIMARY_LINK_CLASS =
    "inline-block bg-accent-green text-background-dark text-sm font-bold py-2 px-4 rounded hover:bg-accent-green/90 transition-colors";
const SECONDARY_LINK_CLASS =
    "inline-block bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 text-sm font-bold py-2 px-4 rounded hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors";

// Orden deliberado, de mayor a menor relevancia para un reclutador (no cronológico).
// No reordenar sin una razón: mover algo hacia arriba implica que es más relevante, no más nuevo.
const proyectos: Proyecto[] = [
    {
        id: "p6",
        image: PinAr,
        alt: "PinAr - Plataforma de eventos deportivos",
        featured: true,
        links: pinArLinks,
    },
    {
        id: "p5",
        image: CajaNeta,
        alt: "Caja Neta App",
        links: [
            {
                labelKey: "pj.button1",
                href: "https://cajanetaapp.com",
                variant: "primary",
            },
        ],
    },
    {
        id: "p1",
        image: Eurogen,
        alt: "Eurogen",
        modalN: 1,
    },
    {
        id: "p2",
        image: Rustico,
        alt: "Rustico",
        modalAlt: "Rustico Hogar",
        modalN: 2,
    },
    {
        id: "p3",
        image: Sonora,
        alt: "Sonora Podcast",
        links: [
            {
                labelKey: "pj.button1",
                href: "https://sonorapodcast.uy",
                variant: "primary",
            },
            {
                labelKey: "pj.button2",
                href: "https://github.com/capua25/SonoraPodcast",
                variant: "secondary",
            },
        ],
    },
];
---

<section id="projects">
    <div class="max-w-5xl xl:max-w-7xl mx-auto">
        <h2
            class="text-3xl font-bold text-center text-gray-900 dark:text-white"
        >
            {translated("pj.title")}
        </h2>
        <div class="mx-auto mt-3 h-0.5 w-12 bg-accent-green rounded-full"></div>
        <div class="mt-12 grid gap-12 md:grid-cols-2 xl:grid-cols-3">
            {
                proyectos.map((proyecto) => (
                    <div
                        class={`bg-card-light dark:bg-gray-800/20 rounded-lg shadow-lg overflow-hidden group border border-transparent hover:border-green-700 dark:hover:border-accent-green transition-all duration-300 ${proyecto.featured ? "xl:col-span-2" : ""}`}
                    >
                        <div class="relative">
                            <Image
                                src={proyecto.image}
                                alt={proyecto.alt}
                                class={`w-full h-56 object-cover ${proyecto.featured ? "xl:h-72" : ""}`}
                            />
                            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-all duration-300" />
                        </div>
                        <div class="p-6">
                            <h3 class="mt-2 text-xl font-bold text-green-700 dark:text-accent-green bg-accent-green/10 rounded-full px-3 inline-block">
                                {translated(
                                    `pj.${proyecto.id}name` as keyof (typeof labels)["en"],
                                )}
                            </h3>
                            <p class="mt-2 text-gray-600 dark:text-gray-300">
                                {translated(
                                    `pj.${proyecto.id}text` as keyof (typeof labels)["en"],
                                )}
                            </p>
                            <div class="mt-4 flex gap-4">
                                {proyecto.links ? (
                                    // Variantes A/C: uno o más links externos.
                                    proyecto.links.map((link) => (
                                        <a
                                            class={
                                                link.variant === "primary"
                                                    ? PRIMARY_LINK_CLASS
                                                    : SECONDARY_LINK_CLASS
                                            }
                                            href={link.href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {translated(link.labelKey)}
                                        </a>
                                    ))
                                ) : proyecto.modalN !== undefined ? (
                                    // Variante B: Modal con la imagen ampliada.
                                    // Si un proyecto tuviera ambos, `links` gana (una acción externa
                                    // pesa más que una preview) y el modal se ignora.
                                    <Modal
                                        title={translated("pj.button1")}
                                        openID={`open${proyecto.modalN}`}
                                        modalID={`modal${proyecto.modalN}`}
                                        closeID={`close${proyecto.modalN}`}
                                    >
                                        <Image
                                            src={proyecto.image}
                                            alt={
                                                proyecto.modalAlt ??
                                                proyecto.alt
                                            }
                                            class="w-full h-3/4 mt-24 object-contain"
                                        />
                                    </Modal>
                                ) : null}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
