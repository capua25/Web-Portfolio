---
interface Metrica {
    valor: string;
    label: string;
}

interface Props {
    metricas: Metrica[];
}

const { metricas } = Astro.props;
---

<div
    class="max-w-5xl mx-auto grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4"
>
    {
        metricas.map((metrica) => (
            <div class="bg-ops-panel rounded-xl p-4 border border-ops-line">
                <p class="font-mono text-2xl sm:text-3xl font-medium text-ops-text">
                    {metrica.valor}
                </p>
                <p class="mt-1 text-xs sm:text-sm text-ops-muted">
                    {metrica.label}
                </p>
            </div>
        ))
    }
</div>
