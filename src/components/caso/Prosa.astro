---
// Contenedor compartido del cuerpo MDX de los casos de estudio (EN y ES).
// El HTML del MDX se renderiza dentro de su propio componente, así que un
// <style> con scope no lo alcanza: se estiliza global pero acotado a
// ".caso-contenido". Las clases de Tailwind escritas dentro del .mdx no se
// generarían nunca (el `content` de tailwind.config.mjs sólo escanea
// {astro,ts}), por eso los estilos viven acá como CSS plano.
---

<article class="max-w-[70ch] mx-auto caso-contenido">
    <slot />
</article>

<style is:global>
    .caso-contenido {
        font-size: 1.0625rem;
        line-height: 1.75;
        color: #b9c5d2;
        overflow-wrap: break-word;
    }
    .caso-contenido h2 {
        margin-top: 3rem;
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.2;
        color: #e7edf3;
    }
    .caso-contenido h3 {
        margin-top: 2rem;
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.3;
        color: #e7edf3;
    }
    .caso-contenido p {
        margin-top: 1rem;
    }
    .caso-contenido strong {
        font-weight: 700;
        color: #e7edf3;
    }
    .caso-contenido a {
        color: #b4c3ff;
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .caso-contenido a:hover {
        color: #8ea4ff;
    }
    .caso-contenido a:focus-visible {
        outline: 2px solid #8ea4ff;
        outline-offset: 2px;
        border-radius: 2px;
    }
    .caso-contenido ul,
    .caso-contenido ol {
        margin-top: 1rem;
        padding-left: 1.5rem;
    }
    .caso-contenido ul {
        list-style: disc;
    }
    .caso-contenido ol {
        list-style: decimal;
    }
    .caso-contenido li {
        margin-top: 0.5rem;
    }
    .caso-contenido li::marker {
        color: #93a1b2;
    }
    .caso-contenido code {
        padding: 0.125rem 0.375rem;
        border-radius: 6px;
        background: #1b2532;
        border: 1px solid #24303f;
        color: #e7edf3;
        font-family:
            "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.875em;
    }
    .caso-contenido pre {
        margin-top: 1.5rem;
        padding: 1rem;
        overflow-x: auto;
        border-radius: 12px;
        background: #121a25;
        border: 1px solid #24303f;
    }
    .caso-contenido pre code {
        padding: 0;
        border: 0;
        background: transparent;
    }
    .caso-contenido blockquote {
        margin-top: 1.5rem;
        padding: 0.25rem 0 0.25rem 1rem;
        border-left: 4px solid #2f3d50;
        color: #93a1b2;
    }
    .caso-contenido hr {
        margin: 2.5rem 0;
        border: 0;
        border-top: 1px solid #24303f;
    }
    .caso-contenido table {
        display: block;
        width: 100%;
        margin-top: 1.5rem;
        overflow-x: auto;
        border-collapse: collapse;
        font-size: 0.9375rem;
    }
    .caso-contenido th,
    .caso-contenido td {
        padding: 0.5rem 0.75rem;
        border: 1px solid #24303f;
        text-align: left;
    }
    .caso-contenido th {
        background: #161f2b;
        color: #e7edf3;
        font-weight: 700;
    }
    /*
     * Bugfix especificidad: ".caso-contenido p" (0,1,1) le gana a las
     * clases de color de Tailwind del Callout (ej. ".text-ops-body",
     * especificidad (0,1,0)), pisando el color semántico del texto.
     * Se le devuelve el control al contenedor ".callout" con :where()
     * para no sumar especificidad propia.
     */
    .caso-contenido :where(.callout) p {
        color: inherit;
    }
    .caso-contenido :where(.callout) strong,
    .caso-contenido :where(.callout) a {
        color: inherit;
    }
    /* Capturas del caso: marco de panel sobre fondo oscuro. */
    .caso-contenido figure {
        margin-top: 2rem;
        margin-bottom: 2rem;
        padding: 0.5rem;
        border-radius: 14px;
        background: #161f2b;
        border: 1px solid #24303f;
    }
    .caso-contenido figure img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
        border: 1px solid #24303f;
    }
    .caso-contenido figcaption {
        margin-top: 0.75rem;
        padding: 0 0.5rem 0.25rem;
        font-size: 0.875rem;
        line-height: 1.5;
        color: #93a1b2;
    }
    /*
     * MDX envuelve el contenido del <figcaption> en un <p>, que si no
     * caería bajo ".caso-contenido p" y le pisaría color y margen.
     * :where() no suma especificidad y le devuelve el control al figcaption.
     */
    .caso-contenido figcaption :where(p) {
        margin-top: 0;
        color: inherit;
    }
</style>
