---
interface Props {
    tipo: "nota" | "alerta" | "dato";
}

const { tipo } = Astro.props;

const estilos = {
    nota: "border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-white/5 text-gray-700 dark:text-gray-300",
    alerta: "border-amber-500 dark:border-amber-400 bg-amber-50 dark:bg-amber-500/10 text-amber-800 dark:text-amber-200",
    dato: "border-green-600 dark:border-accent-green bg-green-50 dark:bg-accent-green/10 text-green-700 dark:text-accent-green",
} as const;
---

<div class={`callout my-6 rounded-lg border-l-4 p-4 text-sm ${estilos[tipo]}`}>
    <slot />
</div>
