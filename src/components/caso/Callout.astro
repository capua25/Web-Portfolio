---
interface Props {
    tipo: "nota" | "alerta" | "dato";
}

const { tipo } = Astro.props;

const estilos = {
    nota: "border-ops-outline bg-ops-pill text-ops-body",
    alerta: "border-ops-pilot bg-ops-pilot-bg text-ops-pilot-text",
    dato: "border-ops-ok bg-ops-ok-bg text-ops-ok-text",
} as const;
---

<div class={`callout my-6 rounded-lg border-l-4 p-4 text-sm ${estilos[tipo]}`}>
    <slot />
</div>
