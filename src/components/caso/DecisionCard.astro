---
import { useTranslation } from "../../i18n/utils";
import { labels } from "../../i18n/ui";

interface Props {
    titulo: string;
    descarte?: string;
}

const { titulo, descarte } = Astro.props;

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);
---

<div
    class="my-8 bg-card-light dark:bg-gray-800/20 rounded-lg border border-gray-200 dark:border-gray-700 p-6"
>
    <h3 class="font-heading text-xl font-bold text-gray-900 dark:text-white">
        {titulo}
    </h3>
    {
        descarte && (
            <p class="mt-2 text-sm font-medium text-gray-500 dark:text-gray-400">
                {translated("caso.descarte")}: {descarte}
            </p>
        )
    }
    <div class="mt-4 text-gray-600 dark:text-gray-300">
        <slot />
    </div>
    <details class="mt-4 group">
        <summary
            class="cursor-pointer text-sm font-bold text-green-700 dark:text-accent-green hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 dark:focus-visible:ring-accent-green rounded-md"
        >
            {translated("caso.detalleTecnico")}
        </summary>
        <div
            class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300"
        >
            <slot name="detalle" />
        </div>
    </details>
</div>
