---
import { useTranslation } from "../../i18n/utils";
import { labels } from "../../i18n/ui";

interface Props {
    titulo: string;
    descarte?: string;
}

const { titulo, descarte } = Astro.props;

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);
---

<div class="my-8 bg-ops-panel rounded-xl border border-ops-line p-6">
    <h3 class="text-xl font-extrabold tracking-tight text-ops-text">
        {titulo}
    </h3>
    {
        descarte && (
            <p class="mt-2 text-sm font-medium text-ops-muted">
                {translated("caso.descarte")}: {descarte}
            </p>
        )
    }
    <div class="mt-4 text-ops-body">
        <slot />
    </div>
    <details class="mt-4 group">
        <summary
            class="cursor-pointer text-sm font-bold text-ops-accent-soft hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ops-accent rounded-md"
        >
            {translated("caso.detalleTecnico")}
        </summary>
        <div class="mt-3 pt-3 border-t border-ops-line-soft text-ops-body">
            <slot name="detalle" />
        </div>
    </details>
</div>
