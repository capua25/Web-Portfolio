---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { useTranslation } from "../../i18n/utils";
import { labels } from "../../i18n/ui";

interface Props {
    titulo: string;
    resumen: string;
    periodo: string;
    rol: string;
    sitioUrl?: string;
    heroImage: ImageMetadata;
}

const { titulo, resumen, periodo, rol, sitioUrl, heroImage } = Astro.props;

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);
---

<header class="max-w-5xl mx-auto">
    <h1
        class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.05] text-ops-text text-balance"
    >
        {titulo}
    </h1>
    <p class="mt-4 text-lg sm:text-xl leading-relaxed text-ops-body max-w-3xl">
        {resumen}
    </p>
    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-ops-muted">
        <div class="flex gap-2">
            <dt class="font-semibold text-ops-text">
                {periodo}
            </dt>
        </div>
        <div class="flex gap-2">
            <dt class="font-semibold text-ops-text">{rol}</dt>
        </div>
    </dl>
    {
        sitioUrl && (
            <div class="mt-8">
                <a
                    class="inline-flex items-center min-h-[44px] px-[18px] rounded-lg bg-ops-accent text-ops-bg text-sm font-bold hover:bg-ops-accent-soft transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ops-accent-soft focus-visible:ring-offset-2 focus-visible:ring-offset-ops-bg"
                    href={sitioUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {translated("caso.visitarSitio")}
                </a>
            </div>
        )
    }
    <div
        class="relative mt-10 rounded-[14px] overflow-hidden border border-ops-line bg-ops-panel"
    >
        <Image
            src={heroImage}
            alt={titulo}
            class="w-full h-64 sm:h-96 object-cover object-left-top"
        />
    </div>
</header>
