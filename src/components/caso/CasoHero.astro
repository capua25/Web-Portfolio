---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { useTranslation } from "../../i18n/utils";
import { labels } from "../../i18n/ui";

interface Props {
    titulo: string;
    resumen: string;
    periodo: string;
    rol: string;
    sitioUrl?: string;
    heroImage: ImageMetadata;
}

const { titulo, resumen, periodo, rol, sitioUrl, heroImage } = Astro.props;

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);
---

<header class="max-w-5xl mx-auto">
    <h1
        class="font-heading text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white"
    >
        {titulo}
    </h1>
    <p class="mt-4 text-xl text-gray-600 dark:text-gray-300">
        {resumen}
    </p>
    <dl
        class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-gray-500 dark:text-gray-400"
    >
        <div class="flex gap-2">
            <dt class="font-bold text-gray-700 dark:text-gray-200">
                {periodo}
            </dt>
        </div>
        <div class="flex gap-2">
            <dt class="font-bold text-gray-700 dark:text-gray-200">{rol}</dt>
        </div>
    </dl>
    {
        sitioUrl && (
            <div class="mt-8">
                <a
                    class="inline-block bg-accent-green text-background-dark text-sm font-bold py-2 px-4 rounded hover:bg-accent-green/90 transition-colors"
                    href={sitioUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {translated("caso.visitarSitio")}
                </a>
            </div>
        )
    }
    <div class="relative mt-10 rounded-lg overflow-hidden shadow-lg">
        <Image
            src={heroImage}
            alt={titulo}
            class="w-full h-64 sm:h-96 object-cover"
        />
    </div>
</header>
