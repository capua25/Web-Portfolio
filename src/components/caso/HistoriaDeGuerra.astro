---
import { useTranslation } from "../../i18n/utils";
import { labels } from "../../i18n/ui";

interface Props {
    titulo: string;
    sintoma?: string;
    causaRaiz?: string;
}

const { titulo, sintoma, causaRaiz } = Astro.props;

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);
---

<div
    class="my-8 bg-ops-panel rounded-xl border border-ops-line border-l-4 border-l-ops-pilot p-6"
>
    <h3 class="text-xl font-extrabold tracking-tight text-ops-text">
        {titulo}
    </h3>
    <dl class="mt-3 space-y-1 text-sm">
        {
            sintoma && (
                <div class="flex gap-2">
                    <dt class="font-bold text-ops-text">
                        {translated("caso.sintoma")}:
                    </dt>
                    <dd class="text-ops-body">{sintoma}</dd>
                </div>
            )
        }
        {
            causaRaiz && (
                <div class="flex gap-2">
                    <dt class="font-bold text-ops-text">
                        {translated("caso.causaRaiz")}:
                    </dt>
                    <dd class="text-ops-body">{causaRaiz}</dd>
                </div>
            )
        }
    </dl>
    <div class="mt-4 text-ops-body">
        <slot />
    </div>
</div>
