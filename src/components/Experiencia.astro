---
import { useTranslation } from "../i18n/utils";
import { labels } from "../i18n/ui";

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);
---

<section id="experience">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white">
      {translated("exp.title")}
    </h2>
    <div class="mx-auto mt-3 h-0.5 w-12 bg-accent-green rounded-full"></div>
    <div class="mt-12 grid md:grid-cols-2 gap-12">
      <div class="relative pl-8 border-l-2 border-green-700/50 dark:border-accent-green/50">
        <div class="absolute -left-1.5 top-0 w-3 h-3 rounded-full bg-green-700 dark:bg-accent-green">
        </div>
        <div class="flex items-center justify-between">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">
            {translated("exp.job1title")}
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            {translated("exp.job1date")}
          </p>
        </div>
        <p class="text-md font-medium text-green-700 dark:text-accent-green mt-1 bg-accent-green/10 rounded-full px-2 inline-block">
          {translated("exp.job1name")}
        </p>
        <ul class="mt-4 list-disc list-inside space-y-2 text-gray-600 dark:text-gray-300">
          <li>
            {translated("exp.job1point1")}
          </li>
          <li>
            {translated("exp.job1point2")}
          </li>
          <li>
            {translated("exp.job1point3")}
          </li>
          <li>
            {translated("exp.job1point4")}
          </li>
          <li>
            {translated("exp.job1point5")}
          </li>
        </ul>
      </div>
      <div class="relative pl-8 border-l-2 border-green-700/50 dark:border-accent-green/50">
        <div class="absolute -left-1.5 top-0 w-3 h-3 rounded-full bg-green-700 dark:bg-accent-green">
        </div>
        <div class="flex items-center justify-between">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">
            {translated("exp.job2title")}
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            {translated("exp.job2date")}
          </p>
        </div>
        <p class="text-md font-medium text-green-700 dark:text-accent-green mt-1 bg-accent-green/10 rounded-full px-2 inline-block">
          {translated("exp.job2name")}
        </p>
        <ul class="mt-4 list-disc list-inside space-y-2 text-gray-600 dark:text-gray-300">
          <li>
            {translated("exp.job2point1")}
          </li>
          <li>
            {translated("exp.job2point2")}
          </li>
          <li>
            {translated("exp.job2point3")}
          </li>
          <li>
            {translated("exp.job2point4")}
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>