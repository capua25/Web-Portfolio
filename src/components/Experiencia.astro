---
import { useTranslation } from "../i18n/utils";
import { labels } from "../i18n/ui";

type Key = keyof (typeof labels)["en"];

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);

const trabajos: { title: Key; date: Key; org: Key; desc: Key }[] = [
    {
        title: "exp.job1.title",
        date: "exp.job1.date",
        org: "exp.job1.org",
        desc: "exp.job1.desc",
    },
    {
        title: "exp.job2.title",
        date: "exp.job2.date",
        org: "exp.job2.org",
        desc: "exp.job2.desc",
    },
];
---

<section class="rounded-[14px] border border-ops-line bg-ops-panel p-[26px]">
    <h2 class="mb-5 text-xl font-extrabold text-ops-text">
        {translated("exp.title")}
    </h2>
    <div class="flex flex-col">
        {
            trabajos.map((t) => (
                <div class="border-b border-ops-line-soft pb-[18px] pt-[18px] first:pt-0 last:border-b-0 last:pb-0">
                    <div class="flex flex-wrap justify-between gap-x-3 gap-y-1">
                        <h3 class="text-base font-bold text-ops-text">
                            {translated(t.title)}
                        </h3>
                        <p class="text-sm text-ops-muted">
                            {translated(t.date)}
                        </p>
                    </div>
                    <p class="mb-2 mt-1 text-sm font-semibold text-ops-accent-soft">
                        {translated(t.org)}
                    </p>
                    <p class="text-[15px] leading-[1.55] text-ops-body">
                        {translated(t.desc)}
                    </p>
                </div>
            ))
        }
    </div>
</section>
