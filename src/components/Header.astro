---
import LangSelect from "../components/LenguajeSelect.astro";

import { useTranslation } from "../i18n/utils";
import { labels } from "../i18n/ui";

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);

interface Props {
    /**
     * Prefijo para los links de navegación por ancla (#systems, #experience,
     * #contact). La home renderiza el Header sin esta prop (comportamiento
     * actual, sin cambios): los links quedan como "#systems". Una página que
     * no es la home (ej. un caso de estudio) pasa la ruta a la home de su
     * idioma, por ejemplo "/" o "/es/", para que los links vuelvan a apuntar
     * a las secciones de la home en vez de anclas inexistentes en esa página.
     */
    hrefBase?: string;
    /**
     * Href explícito al equivalente de la página actual en el otro idioma,
     * que se reenvía tal cual a LangSelect. La home no la pasa (comportamiento
     * actual, sin cambios): LangSelect cae en su fallback de ir a la home del
     * otro idioma. Una página como un caso de estudio, cuya ruta traduce
     * también el segmento de sección (ej. "casos" vs "case-studies"), la pasa
     * para que el selector de idioma apunte a la página equivalente y no a
     * la home.
     */
    altLangHref?: string;
}

const { hrefBase = "", altLangHref } = Astro.props;

const navItems = [
    { href: `${hrefBase}#systems`, label: translated("nav.systems") },
    { href: `${hrefBase}#experience`, label: translated("nav.experience") },
    { href: `${hrefBase}#contact`, label: translated("nav.contact") },
];

const pillClass =
    "inline-flex min-h-10 items-center rounded-lg px-3.5 text-sm font-semibold text-ops-body transition-colors hover:bg-ops-pill hover:text-ops-accent-soft";
---

<header class="border-b border-ops-line-soft bg-ops-bar">
    <div
        class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-x-4 px-4 py-3.5 sm:px-7"
    >
        <a
            href={hrefBase === "" ? "#top" : hrefBase}
            class="flex items-center gap-3 rounded-lg"
        >
            <span
                aria-hidden="true"
                class="flex h-[34px] w-[34px] items-center justify-center rounded-[9px] bg-ops-accent text-sm font-extrabold text-ops-bg"
                >MC</span
            >
            <span class="flex flex-col leading-tight">
                <span class="text-[15px] font-bold text-ops-text"
                    >Martín Capuano</span
                >
                <span class="text-[13px] text-ops-muted"
                    >{translated("header.role")}</span
                >
            </span>
        </a>

        <div class="flex items-center gap-1">
            <!-- Nav desktop (lg+) -->
            <nav
                aria-label={translated("nav.main")}
                class="hidden items-center gap-1 lg:flex"
            >
                {
                    navItems.map((item) => (
                        <a href={item.href} class={pillClass}>
                            {item.label}
                        </a>
                    ))
                }
            </nav>
            <LangSelect altLangHref={altLangHref} />
            <!-- Burger: solo mobile (<lg) -->
            <button
                id="burger"
                type="button"
                aria-label={translated("nav.menu")}
                aria-expanded="false"
                aria-controls="menu"
                class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-ops-body transition-colors hover:bg-ops-pill hover:text-ops-accent-soft lg:hidden"
            >
                <svg
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        d="M4 6h16M4 12h16m-7 6h7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"></path>
                </svg>
            </button>
        </div>

        <!-- Menú mobile: ocupa el ancho completo debajo de la fila principal -->
        <div id="menu" class="hidden w-full lg:hidden">
            <nav
                aria-label={translated("nav.main")}
                class="flex flex-col gap-1 pt-3"
            >
                {
                    navItems.map((item) => (
                        <a href={item.href} class={pillClass}>
                            {item.label}
                        </a>
                    ))
                }
            </nav>
        </div>
    </div>
</header>

<script>
    // Los elementos del menú son parte fija del markup del header (nunca se
    // renderizan condicionalmente, solo se ocultan/muestran vía clases CSS),
    // así que si falta alguno es porque se rompió el markup del navbar.
    function initNav() {
        const burger = document.getElementById("burger");
        const menu = document.getElementById("menu");

        if (!burger || !menu) {
            console.warn(
                "[Header] Faltan elementos del DOM, se omite la inicialización del menú",
            );
            return;
        }

        const setOpen = (open: boolean) => {
            menu.classList.toggle("hidden", !open);
            burger.setAttribute("aria-expanded", String(open));
        };

        burger.addEventListener("click", () => {
            setOpen(burger.getAttribute("aria-expanded") !== "true");
        });

        // Cerrar menú al navegar a una sección
        menu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => setOpen(false));
        });

        // Escape cierra el menú y devuelve el foco al botón
        document.addEventListener("keydown", (event) => {
            if (
                event.key === "Escape" &&
                burger.getAttribute("aria-expanded") === "true"
            ) {
                setOpen(false);
                burger.focus();
            }
        });
    }

    initNav();
</script>
