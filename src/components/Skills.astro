---
import { useTranslation } from "../i18n/utils";
import { labels } from "../i18n/ui";

type Key = keyof (typeof labels)["en"];

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);

// Clases completas (no interpoladas) para que Tailwind las detecte al escanear.
const grupos: { label: Key; items: Key; color: string }[] = [
    {
        label: "skills.g1.label",
        items: "skills.g1.items",
        color: "text-ops-chip-blue-text",
    },
    {
        label: "skills.g2.label",
        items: "skills.g2.items",
        color: "text-ops-chip-purple-text",
    },
    {
        label: "skills.g3.label",
        items: "skills.g3.items",
        color: "text-ops-chip-teal-text",
    },
    {
        label: "skills.g4.label",
        items: "skills.g4.items",
        color: "text-ops-ok-text",
    },
    {
        label: "skills.g5.label",
        items: "skills.g5.items",
        color: "text-ops-chip-amber-text",
    },
];
---

<section class="rounded-[14px] border border-ops-line bg-ops-panel p-[26px]">
    <h2 class="mb-5 text-xl font-extrabold text-ops-text">
        {translated("skills.title")}
    </h2>
    <dl class="flex flex-col gap-3.5 text-[15px]">
        {
            grupos.map((g) => (
                <div class="flex flex-wrap gap-x-4 gap-y-1">
                    <dt class:list={["flex-[0_0_120px] font-bold", g.color]}>
                        {translated(g.label)}
                    </dt>
                    <dd class="min-w-0 flex-[1_1_240px] text-ops-body">
                        {translated(g.items)}
                    </dd>
                </div>
            ))
        }
    </dl>
</section>
