---
import { useTranslation } from "../i18n/utils";
import { labels } from "../i18n/ui";

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);

// El link de mail se arma como HTML crudo (Fragment set:html) en vez de un
// <a href="..."> normal: Astro decodifica las entidades numéricas de un
// atributo estático en tiempo de compilación, así que el href terminaba
// sirviéndose en texto plano aunque el .astro fuente tuviera &#109;&#97;...
// Solo lo que se inyecta vía set:html llega crudo (sin re-parsear) al HTML
// servido, igual que el texto visible del botón.
const emailEntities = translated("contact.email");
const emailLinkHTML = `<a href="mailto:${emailEntities}" class="inline-flex min-h-12 items-center rounded-lg bg-ops-accent px-[22px] font-bold text-ops-bg transition-colors hover:bg-ops-accent-soft hover:text-ops-bg">${emailEntities}</a>`;

const pdfCV =
    currentLang === "en"
        ? "/CV-MartinCapuano-En.pdf"
        : "/CV-MartinCapuano-Es.pdf";

const botonContorno =
    "inline-flex min-h-12 items-center rounded-lg border border-ops-contact-outline px-[18px] font-semibold text-ops-text transition-colors hover:text-ops-accent-soft";
---

<section id="contact" class="pt-14">
    <div
        class="flex flex-wrap items-center justify-between gap-7 rounded-2xl border border-ops-contact-border bg-ops-contact p-6 sm:p-10"
    >
        <div class="min-w-0 flex-[1_1_460px]">
            <h2
                class="text-[clamp(28px,3.4vw,40px)] font-extrabold tracking-[-0.03em] text-ops-text"
            >
                {translated("contact.title")}
            </h2>
            <p class="mt-2.5 text-[17px] text-ops-contact-text">
                {translated("contact.subtitle")}
            </p>
        </div>
        <div class="flex min-w-0 flex-wrap items-center gap-3">
            <Fragment set:html={emailLinkHTML} />
            <a
                href="https://linkedin.com/in/capuanomartin"
                target="_blank"
                rel="noopener noreferrer"
                class={botonContorno}
            >
                {translated("contact.linkedin")}
            </a>
            <a
                href="https://github.com/capua25"
                target="_blank"
                rel="noopener noreferrer"
                class={botonContorno}
            >
                {translated("contact.github")}
            </a>
            <a
                href={pdfCV}
                target="_blank"
                rel="noopener noreferrer"
                class={botonContorno}
            >
                {translated("contact.resume")}
            </a>
        </div>
    </div>
</section>
