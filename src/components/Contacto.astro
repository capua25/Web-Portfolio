---
import { actions, isInputError } from "astro:actions";
import { useTranslation } from "../i18n/utils";
import { labels } from "../i18n/ui";
import Icon from "./Icon.astro";

const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);

// Resultado de la Action cuando el <form> se envía sin JavaScript (POST nativo
// interceptado por Astro). Con JS habilitado, el script de más abajo intercepta
// el submit con fetch y este resultado queda undefined.
const result = Astro.getActionResult(actions.addCommentToDB);

// Timestamp de renderizado del formulario, usado por el action para detectar
// envíos demasiado rápidos (bots). Se recalcula en cada request porque la
// página es SSR (output: 'server').
const formRenderedAt = Date.now();

// El link de mail se arma como HTML crudo (Fragment set:html) en vez de un
// <a href="..."> normal: Astro decodifica las entidades numéricas de un
// atributo estático en tiempo de compilación, así que el href terminaba
// sirviéndose en texto plano aunque el .astro fuente tuviera &#109;&#97;...
// Solo lo que se inyecta vía set:html llega crudo (sin re-parsear) al HTML
// servido, igual que ya pasaba con el texto visible.
// TODO: mover el ícono a Icon.astro — no está en la lista de archivos
// permitidos para este cambio.
const emailEntities = translated("contact.email");
const emailIconSvg = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path></svg>`;
const emailLinkHTML = `<a href="mailto:${emailEntities}" class="inline-flex items-center gap-2 border-2 border-green-700 dark:border-accent-green text-green-700 dark:text-accent-green font-bold py-3 px-6 rounded-lg hover:bg-accent-green hover:text-background-dark transition-all transform hover:scale-105">${emailIconSvg}<span>${emailEntities}</span></a>`;

let serverMessage = "";
let serverMessageType: "success" | "error" | "" = "";

if (result) {
    if (isInputError(result.error)) {
        const msgNombre = result.error.fields.nombre?.join(" ") || "";
        const msgTexto = result.error.fields.texto?.join(" ") || "";
        const parts: string[] = [];
        if (msgNombre.includes("LINKS_NOT_ALLOWED"))
            parts.push(translated("error.message.links"));
        else if (msgNombre.includes("least"))
            parts.push(translated("error.name.short"));
        else if (msgNombre.includes("most"))
            parts.push(translated("error.name.long"));
        if (msgTexto.includes("LINKS_NOT_ALLOWED"))
            parts.push(translated("error.message.links"));
        else if (msgTexto.includes("least"))
            parts.push(translated("error.message.short"));
        else if (msgTexto.includes("most"))
            parts.push(translated("error.message.long"));
        serverMessage =
            parts.length > 0 ? parts.join(" ") : translated("error.generic");
        serverMessageType = "error";
    } else if (result.error) {
        serverMessage = translated("error.generic");
        serverMessageType = "error";
    } else if (result.data?.success) {
        serverMessage = translated("contact.success");
        serverMessageType = "success";
    } else if (result.data) {
        serverMessage = translated("error.generic");
        serverMessageType = "error";
    }
}
---

<section id="contact">
    <div class="max-w-2xl mx-auto">
        <h2
            class="text-3xl font-bold text-center text-gray-900 dark:text-white"
        >
            {translated("contact.title")}
        </h2>
        <div class="mx-auto mt-3 h-0.5 w-12 bg-accent-green rounded-full"></div>
        <p class="mt-4 text-center text-gray-600 dark:text-gray-300">
            {translated("contact.subtitle")}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
            <Fragment set:html={emailLinkHTML} />
            <a
                href="https://www.linkedin.com/in/capuanomartin/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border-2 border-green-700 dark:border-accent-green text-green-700 dark:text-accent-green font-bold py-3 px-6 rounded-lg hover:bg-accent-green hover:text-background-dark transition-all transform hover:scale-105"
            >
                <Icon name="linkedin" class="w-5 h-5" />
                {translated("contact.linkedin")}
            </a>
            <a
                href="https://github.com/capua25/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border-2 border-gray-500 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-bold py-3 px-6 rounded-lg hover:border-green-700 dark:hover:border-accent-green hover:text-green-700 dark:hover:text-accent-green transition-all transform hover:scale-105"
            >
                <Icon name="github" class="w-5 h-5" />
                {translated("contact.github")}
            </a>
        </div>

        <div
            class="mt-14 border-t border-gray-200 dark:border-gray-800"
            role="separator"
        >
        </div>

        <h3
            class="mt-10 text-xl font-bold text-center text-gray-900 dark:text-white"
        >
            {translated("contact.comments")}
        </h3>
        <p class="mt-2 text-center text-sm text-gray-500 dark:text-gray-400">
            {translated("contact.commentssubtitle")}
        </p>
        <form
            id="comentarForm"
            method="POST"
            class="mt-6 space-y-6"
            action={actions.addCommentToDB}
            data-lang={currentLang}
        >
            <div class="sr-only pointer-events-none" aria-hidden="true">
                <label for="website">Website</label>
                <input
                    type="text"
                    id="website"
                    name="website"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                />
            </div>
            <input type="hidden" name="ts" value={formRenderedAt} />
            <div>
                <label
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                    for="name"
                >
                    {translated("contact.name")}
                </label>
                <input
                    class="mt-1 block w-full px-4 py-3 bg-card-light dark:bg-gray-800/20 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-green-700 dark:focus:ring-accent-green focus:border-green-700 dark:focus:border-accent-green"
                    id="name"
                    name="nombre"
                    placeholder={translated("contact.nameplaceholder")}
                    type="text"
                />
            </div>
            <div>
                <label
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                    for="message"
                >
                    {translated("contact.message")}
                </label>
                <textarea
                    class="mt-1 block w-full px-4 py-3 bg-card-light dark:bg-gray-800/20 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-green-700 dark:focus:ring-accent-green focus:border-green-700 dark:focus:border-accent-green"
                    id="message"
                    name="texto"
                    placeholder={translated("contact.messageplaceholder")}
                    rows="4"></textarea>
            </div>
            <div>
                <p
                    id="alertText"
                    class:list={[
                        "text-sm w-full text-center",
                        !serverMessage && "hidden",
                        serverMessageType === "error" && "text-red-600",
                        serverMessageType === "success" &&
                            "text-green-700 dark:text-accent-green",
                    ]}
                >
                    {serverMessage}
                </p>
            </div>
            <div class="text-center">
                <button
                    class="inline-block bg-accent-green text-background-dark font-bold py-3 px-8 rounded-lg hover:bg-accent-green/90 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-green focus-visible:ring-offset-2"
                    type="submit"
                >
                    {translated("contact.button")}
                </button>
            </div>
        </form>
    </div>
</section>
<script>
    import { actions, isInputError } from "astro:actions";
    import { useTranslation } from "../i18n/utils";
    import { labels } from "../i18n/ui";

    const form = document.getElementById("comentarForm") as HTMLFormElement;
    const errorText = document.getElementById(
        "alertText",
    ) as HTMLParagraphElement;
    const currentLang = form.dataset.lang || "en";
    const translated = useTranslation(currentLang as keyof typeof labels);

    form.addEventListener("submit", async (event) => {
        event.preventDefault();

        errorText.classList.remove(
            "hidden",
            "text-red-600",
            "text-accent-green",
            "text-green-700",
        );

        const formData = new FormData(form);
        const username = formData.get("nombre") as string;
        const comment = formData.get("texto") as string;
        if (!username || !comment) {
            errorText.textContent = translated("error.void");
            errorText.classList.add("text-red-600");
            errorText.classList.remove("hidden");
            return;
        }

        const response = await actions.addCommentToDB(formData);

        errorText.textContent = "";
        if (isInputError(response.error)) {
            const msgNombre = response.error.fields.nombre?.toString() || "";
            const msgTexto = response.error.fields.texto?.toString() || "";
            if (msgNombre.includes("LINKS_NOT_ALLOWED")) {
                errorText.innerHTML +=
                    translated("error.message.links") + "<br>";
            } else if (msgNombre.includes("least")) {
                errorText.innerHTML += translated("error.name.short") + "<br>";
            } else if (msgNombre.includes("most")) {
                errorText.innerHTML += translated("error.name.long") + "<br>";
            }
            if (msgTexto.includes("LINKS_NOT_ALLOWED")) {
                errorText.innerHTML +=
                    translated("error.message.links") + "<br>";
            } else if (msgTexto.includes("least")) {
                errorText.innerHTML +=
                    translated("error.message.short") + "<br>";
            } else if (msgTexto.includes("most")) {
                errorText.innerHTML +=
                    translated("error.message.long") + "<br>";
            }
            errorText.classList.add("text-red-600");
            errorText.classList.remove("hidden");
            return;
        } else {
            if (response.data?.success) {
                errorText.innerHTML = translated("contact.success");
                const successClass =
                    document.documentElement.classList.contains("dark")
                        ? "text-accent-green"
                        : "text-green-700";
                errorText.classList.add(successClass);
                errorText.classList.remove("hidden");
                form.reset();
                window.location.reload();
            } else {
                errorText.innerHTML = translated("error.generic");
                errorText.classList.add("text-red-600");
                errorText.classList.remove("hidden");
            }
        }
    });
</script>
