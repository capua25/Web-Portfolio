---
// Componente simple para los íconos SVG reutilizados en el sitio (LinkedIn, GitHub).
// No es un sistema de íconos: es un mapa fijo de paths + props de tamaño/clases.
export type IconName = "linkedin" | "github";

interface Props {
    name: IconName;
    class?: string;
    ariaLabel?: string;
}

const paths: Record<IconName, string> = {
    linkedin:
        "M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014V8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.337 7.433a1.144 1.144 0 01-1.144-1.144c0-.63.513-1.144 1.144-1.144.63 0 1.144.513 1.144 1.144 0 .63-.513 1.144-1.144 1.144zM6.602 16.338H4.074V8.59h2.528v7.748zM18.338 2.016H1.662C.746 2.016 0 2.762 0 3.678v16.644C0 21.238.746 22 1.662 22h16.676c.916 0 1.662-.762 1.662-1.678V3.678c0-.916-.746-1.662-1.662-1.662z",
    github: "M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.165 6.839 9.491.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.031-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.03 1.595 1.03 2.688 0 3.848-2.338 4.695-4.566 4.942.359.308.678.92.678 1.852 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.001 10.001 0 0022 12c0-5.523-4.477-10-10-10z",
};

const { name, class: className, ariaLabel } = Astro.props;
---

{
    ariaLabel ? (
        <svg
            class={className}
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-label={ariaLabel}
        >
            <path clip-rule="evenodd" fill-rule="evenodd" d={paths[name]} />
        </svg>
    ) : (
        <svg
            class={className}
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
        >
            <path clip-rule="evenodd" fill-rule="evenodd" d={paths[name]} />
        </svg>
    )
}
