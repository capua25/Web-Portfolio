---
// Estructura compartida entre src/pages/index.astro (en) y src/pages/es/index.astro (es).
// Cada página solo resuelve su título traducido y delega el resto acá para no duplicar
// la lista de imports ni la jerarquía de secciones en los dos locales.
import Layout from "../layouts/Layout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Resumen from "./Resumen.astro";
import Indicadores from "./Indicadores.astro";
import Sistemas from "./Sistemas.astro";
import Experiencia from "./Experiencia.astro";
import Skills from "./Skills.astro";
import Contacto from "./Contacto.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
    <div class="flex min-h-screen flex-col">
        <Header />
        <main
            class="mx-auto w-full max-w-[1240px] flex-grow px-4 pb-[72px] sm:px-7"
        >
            <Resumen />
            <Indicadores />
            <Sistemas />
            <!-- Experiencia y Stack comparten la grilla de dos paneles -->
            <div
                id="experience"
                class="grid grid-cols-[repeat(auto-fit,minmax(min(460px,100%),1fr))] gap-5 pt-14"
            >
                <Experiencia />
                <Skills />
            </div>
            <Contacto />
        </main>
        <Footer />
    </div>
</Layout>
