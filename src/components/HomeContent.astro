---
// Estructura compartida entre src/pages/index.astro (en) y src/pages/es/index.astro (es).
// Cada página solo resuelve su título traducido y delega el resto acá para no duplicar
// la lista de imports ni la jerarquía de secciones en los dos locales.
import Layout from "../layouts/Layout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Contacto from "./Contacto.astro";
import Experiencia from "./Experiencia.astro";
import Skills from "./Skills.astro";
import Proyectos from "./Proyectos.astro";
import Landing from "./Landing.astro";
import About from "./About.astro";
import Comentarios from "./Comentarios.astro";
import { useTranslation } from "../i18n/utils";
import { labels } from "../i18n/ui";

interface Props {
    title: string;
}

const { title } = Astro.props;

// Astro.currentLocale está disponible en cualquier componente del árbol de render,
// no solo en la página: se usa acá para el fallback del server island de Comentarios.
const currentLang = Astro.currentLocale || "en";
const translated = useTranslation(currentLang as keyof typeof labels);
---

<Layout title={title}>
    <div class="flex flex-col min-h-screen">
        <Header />
        <main class="flex-grow">
            <Landing />
            <div
                class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 space-y-24"
            >
                <About />
                <Experiencia />
                <Skills />
                <Proyectos />
                <Contacto />
                <Comentarios server:defer>
                    <div slot="fallback">
                        <div class="max-w-7xl mx-auto">
                            <h2
                                class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-8"
                            >
                                {translated("comments.title")}
                            </h2>
                            <div
                                class="flex flex-row justify-center flex-wrap gap-6"
                            >
                                {
                                    [0, 1, 2].map((i) => (
                                        <div
                                            class="block w-full sm:w-96 max-w-full p-6 bg-card-light border border-gray-200 rounded-lg shadow-md dark:bg-gray-800 dark:border-gray-700 animate-pulse"
                                            data-skeleton={i}
                                        >
                                            <div class="h-5 w-1/3 bg-gray-300 dark:bg-gray-700 rounded mb-3" />
                                            <div class="h-3 w-1/4 bg-gray-300 dark:bg-gray-700 rounded mb-4" />
                                            <div class="h-3 w-full bg-gray-300 dark:bg-gray-700 rounded" />
                                        </div>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                </Comentarios>
            </div>
        </main>
        <Footer />
    </div>
</Layout>
