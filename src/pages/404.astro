---
import Layout from "../layouts/Layout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

const currentLang = (Astro.currentLocale ?? "en") as "en" | "es";

// Texto local: es una página de error puntual, no comparte copy con el resto
// del sitio, así que no se agregan claves nuevas a src/i18n/ui.ts.
const t = {
    en: {
        title: "404 - Page Not Found",
        heading: "This page doesn't exist",
        message: "The page you're looking for doesn't exist or was moved.",
        back: "Back to home",
    },
    es: {
        title: "404 - Página no encontrada",
        heading: "Esta página no existe",
        message: "La página que buscás no existe o fue movida.",
        back: "Volver al inicio",
    },
}[currentLang];

const homeUrl = getRelativeLocaleUrl(currentLang, "/");
---

<Layout title={t.title}>
    <main
        class="min-h-screen flex flex-col items-center justify-center text-center px-4 bg-ops-bg"
    >
        <div
            class="bg-ops-panel border border-ops-line rounded-[14px] px-6 py-10 sm:px-12 flex flex-col items-center max-w-lg w-full"
        >
            <p
                class="font-mono text-6xl sm:text-7xl font-medium text-ops-accent"
            >
                404
            </p>
            <h1
                class="mt-4 text-xl sm:text-2xl font-extrabold tracking-tight text-ops-text"
            >
                {t.heading}
            </h1>
            <p class="mt-2 text-ops-body max-w-md leading-relaxed">
                {t.message}
            </p>
            <a
                href={homeUrl}
                class="mt-8 inline-flex items-center min-h-[44px] px-[18px] rounded-lg bg-ops-accent text-ops-bg text-sm font-bold hover:bg-ops-accent-soft transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ops-accent-soft focus-visible:ring-offset-2 focus-visible:ring-offset-ops-panel"
            >
                {t.back}
            </a>
        </div>
    </main>
</Layout>
